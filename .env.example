# Proveedor de LLM (gemini o anthropic; por defecto: gemini)
LLM_PROVIDER=gemini

# Clave de API de Google Gemini (obtenela gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Modelo de Google Gemini (recomendado: gemini-2.5-flash)
LLM_MODEL=gemini-2.5-flash

# Configuración alternativa opcional para Anthropic Claude
# ANTHROPIC_API_KEY=

# Configuración para la skill 'enviar-agenda' (Gmail SMTP con TLS)
# 1. Tu dirección de correo de Gmail
GMAIL_REMITENTE=

# 2. Contraseña de Aplicación de 16 letras generada en:
#    https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=
